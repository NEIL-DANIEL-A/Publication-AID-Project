# Supabase credentials - create project at https://supabase.com then copy from Project Settings > API
SUPABASE_URL=
SUPABASE_KEY=
# Use service_role key for server-side pipeline (bypasses RLS) or anon key if RLS disabled for tables
# SUPABASE_SERVICE_ROLE_KEY=  # optional, if using service_role separately

# Optional overrides
# SCOPUS_CACHE_TTL_DAYS=7  # not used (force download enabled)
# MJL_DIRECT_POST_TIMEOUT=10
